{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": false,
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["trusted/**/*.mjs", "capture/**/*.mjs"],
    "exclude": ["trusted/vendor", "trusted/page"]
}
