{
    "name": "@graphty/visual-review",
    "version": "0.0.0",
    "private": true,
    "description": "Visual review of Storybook stories: capture in CI, compare with baselines in git, accept in a local page",
    "type": "module",
    "bin": {
        "visual-review": "./trusted/cli.mjs"
    },
    "scripts": {
        "test": "vitest",
        "test:run": "vitest run",
        "coverage": "vitest run --coverage",
        "lint": "eslint . && npm run typecheck",
        "lint:knip": "cd .. && ./tools/run-knip.sh --workspace visual-review",
        "typecheck": "tsc -p tsconfig.json"
    },
    "devDependencies": {
        "@types/node": "^20.19.9",
        "@vitest/coverage-v8": "catalog:",
        "eslint": "^9.29.0",
        "typescript": "^5.9.3",
        "vitest": "catalog:"
    },
    "dependencies": {
        "playwright": "1.57.0",
        "pngjs": "7.0.0"
    }
}
