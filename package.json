{
    "name": "proofroom",
    "version": "1.0.0",
    "description": "Self-hosted visual review of Storybook stories: capture in GitHub Actions, keep the baselines in git (Git LFS), accept or reject each change in a local page, and gate pull requests",
    "author": "Adam Powers <apowers@ato.ms>",
    "license": "MIT",
    "type": "module",
    "bin": {
        "proofroom": "./trusted/cli.mjs"
    },
    "exports": {
        "./package.json": "./package.json",
        "./compare": {
            "types": "./trusted/lib/compare-api.d.mts",
            "default": "./trusted/lib/compare.mjs"
        },
        "./capture": {
            "types": "./capture/capture-api.d.mts",
            "default": "./capture/capture.mjs"
        },
        "./vitest": {
            "types": "./capture/story-test.d.mts",
            "default": "./capture/story-test.mjs"
        },
        "./vitest/setup": {
            "types": "./capture/story-test-setup.d.mts",
            "default": "./capture/story-test-setup.mjs"
        }
    },
    "files": [
        "trusted/",
        "capture/",
        "templates/",
        "docs/",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "test": "sh -c 'ulimit -c 0 && vitest run' && node --test eslint-rules/*.test.mjs",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "lint": "eslint . && npm run typecheck",
        "typecheck": "tsc -p tsconfig.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/graphty-org/proofroom.git"
    },
    "bugs": {
        "url": "https://github.com/graphty-org/proofroom/issues"
    },
    "homepage": "https://github.com/graphty-org/proofroom#readme",
    "keywords": [
        "storybook",
        "visual-regression",
        "visual-testing",
        "screenshot",
        "snapshot",
        "playwright",
        "github-actions",
        "git-lfs",
        "chromatic-alternative",
        "review"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "dependencies": {
        "pngjs": "7.0.0"
    },
    "peerDependencies": {
        "playwright": ">=1.49.0",
        "vitest": ">=4.0.0"
    },
    "peerDependenciesMeta": {
        "vitest": {
            "optional": true
        }
    },
    "devDependencies": {
        "@commitlint/config-conventional": "19.8.1",
        "@commitlint/lint": "19.8.1",
        "@commitlint/load": "19.8.1",
        "@eslint/js": "9.39.5",
        "@playwright/test": "1.57.0",
        "@types/node": "20.19.9",
        "@vitest/coverage-v8": "4.1.11",
        "ajv": "8.20.0",
        "eslint": "9.39.5",
        "eslint-plugin-jsdoc": "50.8.0",
        "globals": "15.15.0",
        "jest": "30.5.2",
        "mocha": "11.7.5",
        "playwright": "1.57.0",
        "typescript": "5.9.3",
        "vite": "7.3.6",
        "vitest": "4.1.11"
    }
}
